{
  "name": "nesdb-website",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build && cross-env NODE_ENV=production tsx scripts/generate-static.tsx",
    "preview": "rsbuild preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "rsync -e ssh -acpvz out/ ubuntu@denohub.com:/var/www/nesdb.denohub.com/"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nes-db": "^1.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "htmlWhitespaceSensitivity": "ignore"
  }
}
